# Copy to .env.local and fill in from your Supabase project's
# Settings -> API page. Both are safe to expose to the browser (the anon
# key is subject to RLS, same as every request from the client).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose this with a NEXT_PUBLIC_ prefix. Used by
# lib/ai/client.ts for document classification (spec 5) and AI-suggested
# pricing lines. Get a key at https://console.anthropic.com/settings/keys.
# Without this set, the "Classify with AI" / "Suggest Pricing Lines"
# actions fail with a clear error rather than silently doing nothing.
ANTHROPIC_API_KEY=
